# Copy to .env and fill in. NEVER commit this file or real values.

# Minds Builder API key (created in the Builder console). The persistent Mind owns continuity.
MINDS_BUILDER_API_KEY=
# The REMNANT Mind id (created via hellominds.ai)
MIND_ID=

# Backend
REMNANT_HOST=127.0.0.1
REMNANT_PORT=8000
STORAGE_PATH=./data/remnant.db

# Data honesty
# Path to a real community export if available (preferred), else a clearly-labeled synthetic corpus.
# Never mislabel synthetic data as real.
DEMO_CORPUS_PATH=
